# AI (optional – without a key the AI features are turned off)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_ENABLED=true
AI_RATE_LIMIT_PER_HOUR=20
AI_DAILY_REQUEST_CAP=500
# Show local model options (browser, own server)
NEXT_PUBLIC_LOCAL_AI_ENABLED=true

# Rate limit storage (optional, recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Connectors
CONNECTORS_ENABLED=true
# true only for local development
CONNECTORS_ALLOW_PRIVATE=false
# e.g. Neon Postgres, read-only role
DEMO_DATABASE_URL=

# General
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/makrpai/dashthedata
